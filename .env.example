SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
YANDEX_MAPKIT_API_KEY=YOUR_YANDEX_MAPKIT_API_KEY
# IMPORTANT: ключ из кабинета Яндекса → «MapKit — мобильный SDK»
# (НЕ JavaScript API / HTTP Геокодер). Пакет приложения: ru.moystrikbol.app

# Firebase / FCM (system push). Leave empty to disable until configured.
# 1) Create Firebase project, add Android app ru.moystrikbol.app
# 2) Download google-services.json → android/app/google-services.json
# 3) (iOS) GoogleService-Info.plist → ios/Runner/ + Push capability
# 4) Fill values from Firebase console / flutterfire configure:
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=ru.moystrikbol.app

# Server push (Supabase Edge Function send-push):
# supabase functions deploy send-push --no-verify-jwt
# supabase secrets set PUSH_HOOK_SECRET=... FIREBASE_SERVICE_ACCOUNT_JSON='{...}'
# Then SQL:
# UPDATE public.push_dispatch_config
# SET edge_url = 'https://YOUR_PROJECT.supabase.co/functions/v1/send-push',
#     hook_secret = 'SAME_SECRET', enabled = true WHERE id = 1;
